# Скопіюй у .env (корінь репо) для docker compose
# або у backend/.env для локального запуску без Docker.

# --- Backend ---
NODE_ENV=development
PORT=4000
# У Docker хост бази = ім'я сервісу "mongo"; локально без Docker — localhost
MONGO_URI=mongodb://mongo:27017/chronos
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/chronos   # варіант з MongoDB Atlas

# JWT (згенеруй: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Адреса фронту (CORS, посилання в листах)
CLIENT_URL=http://localhost:3000

# Пошта (nodemailer). Для dev підійде Ethereal або Mailtrap
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chronos <no-reply@chronos.local>"

# Державні свята (Nager.Date) і країна за замовчуванням
HOLIDAYS_API_URL=https://date.nager.at/api/v3
DEFAULT_COUNTRY=UA
